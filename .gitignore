# ════════════════════════════════════════════════════════════════
#  标准处理系统 — 版本库忽略规则
# ════════════════════════════════════════════════════════════════
#
#  【核心原则】本仓库只存放**源码与构建脚本**，不存放构建产物、发行包、内部文档。
#
#  【重要】本仓库一旦公开，任何被提交的内容都会**永久留在 Git 历史**中——
#          即使后来删除文件，历史提交、GitHub 的镜像与第三方 fork 中依然存在。
#          提交前请用 `git status` 与 `git diff --cached --stat` 逐项确认。
#
#  本文件由法务/工程联合拟定，改动前请查阅：
#      _内部_文档与代码同步记录.md（该文件本身也在忽略之列）

# ── 一、构建产物与发行包（6 GB+，且属"目标代码"而非源码）──────────
Standard Processing System*/
*.rar
*.zip
*.7z
*.tar
*.gz
dist/
build/
__pycache__/
*.pyc
*.pyo
*.pyd

# 随发行版分发的第三方二进制（不应进版本库）
tesseract-ocr-w64-setup-*.exe

# ── 二、内部文档（含安全审计信息与攻击面清单，绝不可公开）────────
#  整个内部工作目录：含内部文档、核查脚本、旧版协议、被取代的产物。
#  用目录级规则兜底，避免日后新增的内部文件漏网。
工作用内容*/
_工作记忆_HANDOFF.md
_内部_文档与代码同步记录.md
专家要求总清单_*.md
产品专家问题清单_*.md
卡顿与体验问题专项_*.md
变更记录_*.md
法务审查意见_*.md

# ── 三、内部测试与核查脚本 ────────────────────────────────────
#  说明：这些脚本记录了本机的绝对路径、测试方法与安全验证细节。
#        如需公开，请先逐个复核后再移入 tests/ 目录。
_verify_*.py
_check_*.py
_ui_*.py
_tmp_*.py
_fix_*.py

# ── 四、已被取代的旧文档 ──────────────────────────────────────
#  说明：《用户协议》v2.1 已被《许可、隐私与免责说明》v3.0 取代，
#        其内容与本系统实际实现存在多处不符，不应再分发。
标准处理系统 用户协议*
~$*

#  许可说明的整张长图（28 MB，由 docx 渲染生成）。
#  安装器实际使用的是「安装程序/标准处理系统 许可隐私与免责说明/」下的 28 张单页图，
#  本文件属派生物；如需对外提供预览，应作为 GitHub Release 附件上传，
#  而不是提交进版本库（二进制文件一旦提交会永久留在 Git 历史中）。
标准处理系统 许可、隐私与免责说明.jpg

# ── 五、本机用户数据与工具配置 ─────────────────────────────────
.app_settings.json
.tutorial_state.json
.codebuddy/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ── 六、敏感配置（不得纳入版本库）──────────────────────────────
#  ⚠ 反馈功能的钉钉 Webhook 地址与签名密钥当前**内置于源码**
#    （web/server.py 的 _FEEDBACK_DEFAULT_WEBHOOK / _FEEDBACK_DEFAULT_SECRET）。
#    公开仓库前请先将其移入下列私有配置文件，并从源码中删除。
#    否则该密钥会被搜索引擎与爬虫永久收录，无法撤回。
_feedback_private.py
.env
*.local
secrets/

# ── 七、许可文本备用件（licenses/ 目录已含规范版本）─────────────
AGPL3.txt

# ── 八、本轮新增的内部脚本与生成物（2026-09-30 补）────────────────────────
#  说明：本仓库公开时，任何被提交过的内容都会**永久留在 Git 历史**里，
#        事后删除文件也追不回来。以下均为内部工具/生成物，不入版本库。
_apply_*.py
_make_*.py
测试样例_自动生成/
_append_*.py

# ── 九、用户数据（绝不可进版本库：字典里是使用者积累的标准名称）────────
标准名称字典.db
标准名称字典.db-wal
标准名称字典.db-shm
标准名称字典.txt
